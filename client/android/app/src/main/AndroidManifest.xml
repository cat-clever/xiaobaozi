<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      端内升级要装 APK。Android 8 起这是普通权限（装上就有），
      但用户还得在系统设置里给本应用打开「安装未知应用」——
      没打开时 App 会把自己送到那一页（见 UpdaterModule.openUnknownSourcesSettings）。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      投屏发现（SSDP 组播）要拿 MulticastLock —— 不拿的话 Wi-Fi 芯片会把组播包
      丢掉，只有「把响应发回组播组」的那类设备（不合规但真实存在）会收不到。
      见 `cast/SsdpModule.kt`。
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!--
      投屏要枚举局域网接口 / 判断当前连的是不是 Wi-Fi（有 Wi-Fi 才谈得上投屏）。
      ★ `ACCESS_NETWORK_STATE` 是普通权限；下面那个 `NEARBY_WIFI_DEVICES` 是
        Android 13+ 才有的，声明时带 `maxSdkVersion` 反而会让新系统拿不到 ——
        所以**不声明**：我们只用 `WifiManager` 拿组播锁和 IP，不扫周边 Wi-Fi，
        不属于它的管辖范围。
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
      转发投屏保活（见 `cast/RelayKeepAliveService.kt`）。

      ★ 转发模式下流经手机的本地媒体服务：进程一被冻结，电视立刻断流
        （2026-10-20 真机定位：端口还在监听、TCP 能连、一个字节都不回）。
        前台服务 + 唤醒锁是唯一能让系统不冻进程的手段。

      ★ Android 14+（targetSdk 36）起前台服务**必须**声明类型对应的权限，
        类型在下面 <service> 的 `foregroundServiceType` 里。用 `mediaPlayback`
        而不是 `dataSync`：后者在 Android 15 起有每天 6 小时上限。

      ★ `POST_NOTIFICATIONS`（Android 13+）：不给也能跑，只是通知不显示。
        不主动弹权限 —— 为一个"投屏时才有"的通知打断用户不值得。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="true"
      android:networkSecurityConfig="@xml/network_security_config"
      android:supportsRtl="true">
      <!--
        android:supportsPictureInPicture —— 画中画（悬浮到桌面）必须在清单里声明，
        react-native-video 的 PictureInPictureUtil 会去读这个 flag 判断能不能进。
        configChanges 里那几个 screenSize / smallestScreenSize / orientation 是
        **必须的**：不声明的话进画中画时 Activity 会被重建，播放直接断。
      -->
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:supportsPictureInPicture="true"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!--
        转发投屏期间的保活服务。生命周期由 JS 控制
        （`MediaServer.startRelayKeepAlive / stopRelayKeepAlive`），
        只在**转发模式**投屏期间开着 —— 直投是电视自己去 CDN 取流，不需要。
      -->
      <service
        android:name=".cast.RelayKeepAliveService"
        android:exported="false"
        android:foregroundServiceType="mediaPlayback"
        android:stopWithTask="true" />

      <!--
        端内升级下载的 APK 要交给系统安装器，而 Android 7 起 `file://` 直接抛
        FileUriExposedException —— 必须用 FileProvider 包成 content://
        （见 UpdaterModule.launchInstaller）。
        ★ authority 必须与 Kotlin 里用的一致：`packageName + ".updater"`
        （applicationId 就是 com.xiaobaozi.video），`${applicationId}` 由
          AGP 自动展开。
      -->
      <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.updater"
        android:exported="false"
        android:grantUriPermissions="true">
        <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/file_paths" />
      </provider>
    </application>
</manifest>
