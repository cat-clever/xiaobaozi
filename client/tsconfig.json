{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "__tests__/**/*.ts", "App.tsx", "index.js"],
  "exclude": ["node_modules", "android", "ios", "**/*.test.ts"]
}
